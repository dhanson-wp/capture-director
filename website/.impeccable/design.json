  "narrative": {
    "northStar": "Working film treatment",
    "overview": "The implemented website uses a working film treatment: oversized titles, broad color fields, viewfinder corners, and a compact editing timeline. It's a marketing surface for builders using Codex or Claude Code, implemented directly in Astro with GSAP. This system belongs to the website; it doesn't prescribe the CLI's interface.\n\nThe final cascade in `src/styles/global.css` is authoritative. Earlier declarations include superseded radius, palette, and hero measurements; don't restore them when extending the page. `SURFACE.md` records the approved first surface, and `../PRODUCT.md` carries product facts.",
    "keyCharacteristics": [
      "Citron, pool, and mulberry color fields",
      "Self-hosted Bricolage Grotesque and Manrope",
      "Real footage and an illustrated write, record, edit, export sequence",
      "Readable static content before animation"
    ],
    "rules": [
      {
        "name": "The Three Inks Rule",
        "body": "Keep the broad fields citron, pool, and mulberry; supporting colors serve copy, dividers, and footage chrome.",
        "section": "colors"
      }
    ],
    "dos": [
      "Do retain the citron, pool, and mulberry identity.",
      "Do use the existing real demo and its poster as product evidence.",
      "Do keep all workflow instructions readable without animation.",
      "Do preserve visible keyboard focus and native video controls."
    ],
    "donts": [
      "Don't return to the rejected warm paper and recording red palette.",
      "Don't add generated raster artwork or invented social proof.",
      "Don't require pinned scrolling on mobile or with reduced motion.",
      "Don't extend website styling into the CLI without a separate decision."
    ]
  }
